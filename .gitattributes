# 줄바꿈 정규화 — Windows 에서 작업하고 Linux CI 에서 실행하므로 필수
* text=auto eol=lf

# 텍스트로 다뤄 diff 가 보이게 한다
*.py      text diff=python
*.md      text
*.yaml    text
*.yml     text
*.toml    text
*.csv     text
*.svg     text
*.rpt     text
*.tex     text

# Windows 전용 스크립트가 생기면 CRLF 유지
*.bat     text eol=crlf
*.ps1     text eol=crlf

# 바이너리 — diff 하지 않는다
*.png     binary
*.pdf     binary
*.npz     binary
*.pt      binary
*.safetensors binary
